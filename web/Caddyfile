# Iris en el VPS: la página, los instaladores y, más adelante, la API de la tienda.
# Mientras no haya dominio propio, sslip.io da un nombre con HTTPS real para la IP.
167-86-91-183.sslip.io {
	root * /var/www/iris
	encode zstd gzip
	# Los instaladores se piden con curl o irm: texto plano y sin caché, que cambian con cada versión.
	@instaladores path /install.sh /install.ps1
	header @instaladores Content-Type "text/plain; charset=utf-8"
	header @instaladores Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	file_server
}

# La IP sola lleva al nombre con HTTPS.
http://167.86.91.183 {
	redir https://167-86-91-183.sslip.io{uri} permanent
}
