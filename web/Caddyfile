# Iris en el VPS: la página, los instaladores y, más adelante, la API de la tienda.
iris.knarvaez.com {
	root * /var/www/iris
	encode zstd gzip
	# Los instaladores se piden con curl o irm: texto plano y sin caché, que cambian con cada versión.
	@instaladores path /install.sh /install.ps1
	header @instaladores Content-Type "text/plain; charset=utf-8"
	header @instaladores Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	file_server
}

# El nombre provisional de antes y la IP sola llevan al dominio.
167-86-91-183.sslip.io, http://167.86.91.183 {
	redir https://iris.knarvaez.com{uri} permanent
}
